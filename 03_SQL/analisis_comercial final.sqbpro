<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="analisis_comercial.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1235"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="0"/><expanded_item id="2" parent="0"/><expanded_item id="3" parent="0"/><expanded_item id="4" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="tabla_categorias" custom_title="0" dock_id="4" table="4,16:maintabla_categorias"/><dock_state state="000000ff00000000fd0000000100000002000001380000026cfc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000000001380000000000000000fb000000160064006f0063006b00420072006f00770073006500340100000000ffffffff0000011800ffffff000001380000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">SELECT 
    pe.order_date AS fecha_pedido,
    COALESCE(pe.total_amount, 0) AS ingresos,
    COALESCE(pe.quantity, 0) AS unidades,
    CASE 
        WHEN pe.id % 3 = 0 THEN 'Completado'
        WHEN pe.id % 3 = 1 THEN 'Pendiente'
        ELSE 'Cancelado'
    END AS estado_venta,
    COALESCE(pa.payment_method, 'Sin definir') AS metodo_pago,
    COALESCE(c.city, 'Sin registrar') AS region,
    COALESCE(c.full_name, 'Cliente Anónimo') AS cliente, 
    COALESCE(pr.product_name, 'Producto Desconocido') AS producto,
    COALESCE(ca.category_name, 'Sin categoría') AS categoria
FROM tabla_pedidos pe
LEFT JOIN tabla_pagos pa ON pe.id = pa.order_id
LEFT JOIN tabla_clientes c ON pe.customer_id = c.id
LEFT JOIN tabla_productos pr ON pe.product_id = pr.id
LEFT JOIN tabla_categorias ca ON pr.category_id = ca.id;</sql><current_tab id="0"/></tab_sql></sqlb_project>
